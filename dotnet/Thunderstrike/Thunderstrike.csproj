<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 keeps .NET Framework 4.6.1+, Unity and Xamarin
         in reach; net8.0 gets the native-library resolver and nullable
         annotations. Only classic DllImport is used, so both work. -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- No <Version>: scripts/package-nuget.sh passes -p:Version from the tag. -->
    <PackageId>Thunderstrike</PackageId>
    <Description>Client for the thunderstrike key-value database.</Description>
    <RootNamespace>Thunderstrike</RootNamespace>
  </PropertyGroup>

  <!-- Set only by scripts/package-nuget.sh. ThunderstrikeNativeDir holds
       <rid>/native/<library> (pack appends the path below the
       wildcard), so each lands at runtimes/<rid>/native/, where
       restore puts it on the app's probing path (deps.json) and
       publish copies it next to the app. -->
  <PropertyGroup Condition="'$(ThunderstrikeNativeDir)' != ''">
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(ThunderstrikeNativeDir)' != ''">
    <None Include="$(ThunderstrikeNativeDir)/**/*" Pack="true" PackagePath="runtimes/" />
    <None Include="$(ThunderstrikeLicenseFile)" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
