{
  "name": "themanhattanproject/thunderstrike-client",
  "description": "PHP client for the thunderstrike key-value database: pooled, pipelined TLS 1.3 connections and batch operations, over FFI",
  "type": "library",
  "license": "proprietary",
  "keywords": ["thunderstrike", "key-value", "kv", "database", "client", "ffi", "tls"],
  "homepage": "https://github.com/TheManhattanProject/thunderstrike-client",
  "authors": [
    {
      "name": "SHORTSQUEEZE PRIVATE LIMITED",
      "homepage": "https://github.com/TheManhattanProject"
    }
  ],
  "support": {
    "issues": "https://github.com/TheManhattanProject/thunderstrike-client/issues",
    "source": "https://github.com/TheManhattanProject/thunderstrike-client",
    "docs": "https://github.com/TheManhattanProject/thunderstrike-client/tree/main/php"
  },
  "require": {
    "php": ">=8.1",
    "ext-ffi": "*"
  },
  "suggest": {
    "ext-zlib": "bin/thunderstrike-install unpacks the native bundle with it",
    "ext-curl": "bin/thunderstrike-install downloads with it when present"
  },
  "autoload": {
    "psr-4": {
      "Thunderstrike\\": "php/src/"
    }
  },
  "bin": ["php/bin/thunderstrike-install"]
}
